# ---------------------------------------------------------------------
# Copy to .env.local. Everything here has a working default except the
# codes, which you should change before anyone else can reach the app.
# ---------------------------------------------------------------------

# Signs the staff login cookie. Any random string, 32+ chars.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=change-me-to-something-random-and-long

# The Judge Advisor code — full control. Keep this one to yourself.
ADMIN_CODE=JA2026

# The queue desk code — can add teams to the queue and undo an entry
# before judges pick it up. Nothing else.
QUEUER_CODE=DESK01

# Where the data file lives. Defaults to .data/state.json.
# Point this at a stable path if you deploy somewhere with a mounted disk.
# DATA_FILE=.data/state.json

# Set to false to start with an empty roster instead of demo teams.
# Only applies the first time, when no data file exists yet.
# SEED_DEMO=false

# Judge panel codes are NOT set here. Each panel gets its own, managed
# in the admin console under the Panels tab.
