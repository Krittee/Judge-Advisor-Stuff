# ---------------------------------------------------------------------
# Copy to .env.local for local dev. On Vercel, add these under
# Settings > Environment Variables instead.
# ---------------------------------------------------------------------

# Supabase > Project Settings > Data API  ("Project URL")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase > Project Settings > API Keys  ("service_role" / secret key)
# SECRET. Never prefix with NEXT_PUBLIC_. It bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the staff login cookie. Any random string, 32+ chars.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=change-me-to-something-random-and-long

# The Judge Advisor code — full control. Keep this one to yourself.
ADMIN_CODE=JA2026

# The queue desk code — can add teams to the queue and undo an entry
# before judges pick it up. Nothing else.
QUEUER_CODE=DESK01

# Judge panel codes are NOT set here. Each panel gets its own code,
# managed in the admin console under the Panels tab.
