# ---------------------------------------------------------------------
# Local development. Copy to .env.local and edit.
#
# Deploying to a hosting service instead? You set these in that service's
# dashboard, not here. See DEPLOY.md.
# ---------------------------------------------------------------------

# Signs the staff login cookie. Any random string, 32+ chars.
# Generate one with:  openssl rand -base64 32
# The placeholder below is for local development only: a deployed app
# refuses to sign anyone in with it.
SESSION_SECRET=change-me-to-something-random-and-long

# Judge Advisor codes — full control. Give each administrator their own.
# The first is required in production; the other three are optional.
# There are deliberately no slots beyond 4.
ADMIN_CODE=JA2026
ADMIN_CODE_2=
ADMIN_CODE_3=
ADMIN_CODE_4=

# The queue desk code — can add teams to the queue and undo an entry
# before judges pick it up. Nothing else.
QUEUER_CODE=DESK01
REFEREE_CODE=REF001
# The head referee's code: a referee who also sets the program and fields (keep it different from REFEREE_CODE).
HEAD_REFEREE_CODE=HREF01

# --- Storage ---------------------------------------------------------
# Leave DATABASE_URL unset and everything is kept in one JSON file, which
# is what makes `npm run dev` work with no setup at all.
#
# Set it to a Postgres connection string and the app uses that instead,
# creating its own tables on first run. Required on serverless hosting,
# where there is no disk for a file to live on.
# DATABASE_URL=postgresql://user:password@host/dbname
#
# Supabase: dashboard > Connect > "Transaction pooler" (port 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Where the file store keeps its data.
# DATA_FILE=.data/state.json

# Demo teams: on in development, off in production. Force it either way.
# SEED_DEMO=false

# Sign-in attempts are rate limited. By default every failed attempt counts
# in ONE shared bucket, because X-Forwarded-For is written by the client and
# cannot be believed. Vercel is detected automatically and needs nothing.
# Set this to 1 ONLY if your own reverse proxy sits in front of the app and
# overwrites or appends to X-Forwarded-For (the last entry is used). If it
# passes the client's header through untouched, leave this unset: setting it
# would let anyone dodge the limit by changing that header.
# TRUST_PROXY=1

# Judge panel codes are NOT set here. Each panel gets its own, managed
# in the admin console under the Panels tab.
